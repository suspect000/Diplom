<Window x:Class="Dickplom1.Windows.Others.CustomPasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Dickplom1.Windows.Others"
        xmlns:customControls="clr-namespace:CustomControlsForDiplomFramework;assembly=CustomControlsForDiplomFramework"
        Title="Временный пароль"
        Height="250" Width="600"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="Transparent"
        WindowStyle="None"
        Loaded="Window_Loaded"
        AllowsTransparency="True">
    <Border
        Width="500" Height="150"
        Background="White"
        CornerRadius="20">
        <Border.Effect>
            <DropShadowEffect 
                BlurRadius="50" 
                ShadowDepth="10" 
                Direction="270"/>
        </Border.Effect>
        <Grid Margin="15">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel
                Orientation="Horizontal">
                <TextBlock Text="Временный пароль для:" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"
                           Style="{StaticResource DefText15}"/>
                <Separator Opacity="0" Width="5"/>
                <TextBlock 
                    Name="tbFullName"
                    MaxWidth="280"
                    Text="Сапожников Владислав Игоревич" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"
                           Style="{StaticResource DefText15}"/>
            </StackPanel>

            <customControls:TextboxWithBorder 
                x:Name="tbPassword"
                Grid.Row="1" 
                IsHitTestVisible="False"
                FontSize="16"
                VerticalContentAlignment="Center"
                HorizontalAlignment="Stretch"
                Margin="0,0,0,10"/>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button 
                    Name="btnCopy"
                    Style="{StaticResource BtnClearBackground}"
                    Content="Скопировать" Click="CopyButton_Click" Margin="0,0,10,0"
                    Cursor="Hand"
                    MouseEnter="Button_MouseEnter"
                    MouseLeave="Button_MouseLeave"/>
                <Button 
                    Name="btnOk"
                    Style="{StaticResource BtnClearBackground}"
                    Content="ОК" Width="80" Click="OkButton_Click"
                    Cursor="Hand"
                    MouseEnter="Button_MouseEnter_1"
                    MouseLeave="Button_MouseLeave_1"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
