<Window x:Class="Dickplom1.Windows.Others.OrdersNaturalPersonsAddWin"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Dickplom1.Windows.Others"
        xmlns:customControls="clr-namespace:CustomControlsForDiplomFramework;assembly=CustomControlsForDiplomFramework"
        WindowStyle="None"
        Background="Transparent"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        AllowsTransparency="True"
        VerticalAlignment="Center"
        mc:Ignorable="d"
        Height="700" Width="600"
        Loaded="Window_Loaded">
    <Border
        Width="500" Height="600"
        CornerRadius="20">
        <Border.Background>
            <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0" MappingMode="RelativeToBoundingBox">
                <LinearGradientBrush.RelativeTransform>
                    <TransformGroup>
                        <ScaleTransform CenterY="0.5" CenterX="0.5"/>
                        <SkewTransform CenterX="0.5" CenterY="0.5"/>
                        <RotateTransform Angle="135" CenterX="0.5" CenterY="0.5"/>
                        <TranslateTransform/>
                    </TransformGroup>
                </LinearGradientBrush.RelativeTransform>
                <GradientStop Color="#C3C7D2"/>
                <GradientStop Color="#F7F7FA" Offset="1"/>
            </LinearGradientBrush>
        </Border.Background>
        <Border.Effect>
            <DropShadowEffect 
                BlurRadius="50" 
                ShadowDepth="10" 
                Direction="270"/>
        </Border.Effect>
        <Grid
            x:Name="mainGrid"
            Background="Transparent"
            PreviewMouseLeftButtonDown="mainGrid_PreviewMouseLeftButtonDown">
            <Grid 
                x:Name="gridFocus"
                Focusable="True"
                Width="1" Height="1"
                Background="Transparent">

            </Grid>
            <Grid
                x:Name="gridMovingWin"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Top"
                Height="20"
                Background="Transparent"
                GotKeyboardFocus="gridMovingWin_GotKeyboardFocus"
                Focusable="False"/>

            <customControls:ButtonClose
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="0,20,20,0"/>

            <Grid 
                Panel.ZIndex="1">

                <Label 
                    Style="{StaticResource TextZagolovokDashboard}"
                    Foreground="#636C7F"                    
                    FontSize="25"
                    Padding="0"
                    Content="Информация о заказе (физ. лица)"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    Margin="0,40,0,0"/>

                <StackPanel
                    x:Name="sp"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    Width="400"
                    Orientation="Vertical"
                    Margin="40,120,0,0">

                    <StackPanel 
                        Orientation="Horizontal">
                        
                        <customControls:ComboboxMaterialDesignWithBorder
                            x:Name="cboxSubscription"
                            Loaded="cboxSubscription_Loaded"
                            Width="360"/>

                        <Separator Opacity="0" Width="15"/>

                        <customControls:btnAddPlusWhiteTheme
                            Width="25" Height="30"
                            Source="../../Resources/Images/OtherWins/btnAddIcnWhiteTheme.png"
                            MouseLeftButtonUp="btnAddSubscription_Click"/>
                        
                    </StackPanel>

                    <Separator Opacity="0" Height="10"/>

                    <customControls:CustomDatePickerWithBorder    
                        x:Name="datePicker"
                        Loaded="datePicker_Loaded"
                        Width="360"
                        HorizontalAlignment="Left"
                        TextInput="datePicker_TextInput"/>


                    <Separator Opacity="0" Height="10"/>

                    <StackPanel
                        Orientation="Horizontal">
                        <customControls:ComboboxMaterialDesignWithBorder
                            Loaded="cboxClient_Loaded"
                            x:Name="cboxClient"
                            Width="360"
                            HorizontalAlignment="Left"/>

                        <Separator Opacity="0" Width="15"/>

                        <customControls:btnAddPlusWhiteTheme
                            Width="25" Height="30"
                            Source="../../Resources/Images/OtherWins/btnAddIcnWhiteTheme.png"
                            MouseLeftButtonUp="btnAddPlusWhiteTheme_MouseLeftButtonUp"/>

                    </StackPanel>

                    <Separator Opacity="0" Height="10"/>

                    <customControls:ComboboxMaterialDesignWithBorder  
                        Loaded="cboxOrderStatus_Loaded"
                        x:Name="cboxOrderStatus"
                        Width="360"
                        HorizontalAlignment="Left"/>

                    <Separator Opacity="0" Height="40"/>

                    <Border
                        BorderBrush="{StaticResource ScrollViewerBackgroundOther}"
                        BorderThickness="1"
                        Height="185"
                        CornerRadius="20"
                        Width="360"
                        HorizontalAlignment="Left">

                        <Grid
                            VerticalAlignment="Center">
                            <StackPanel 
                                Orientation="Horizontal"
                                VerticalAlignment="Top"
                                HorizontalAlignment="Left"
                                Margin="55,0,0,0">
                                <Label 
                                Style="{StaticResource TextZagolovokDashboard}"
                                Content="Подписка:"
                                Foreground="#A1A2A2"
                                FontSize="13"
                                Padding="0"
                                HorizontalAlignment="Left" VerticalAlignment="Top"/>

                                <Separator Opacity="0" Width="5"/>

                                <TextBlock
                                    x:Name="tblockSubscription"
                                    Style="{StaticResource DefText13}"
                                    FontFamily="Franklin Gothic Medium"
                                    HorizontalAlignment="Left" VerticalAlignment="Top"/>
                            </StackPanel>

                            <StackPanel 
                                Orientation="Horizontal"
                                VerticalAlignment="Top"
                                HorizontalAlignment="Left"
                                Margin="13,30,0,0">
                                <Label 
                                    Style="{StaticResource TextZagolovokDashboard}"
                                    Content="Сроки подписки:"
                                    Foreground="#A1A2A2"
                                    FontSize="13"
                                    Padding="0"
                                    HorizontalAlignment="Left" VerticalAlignment="Top"/>

                                <Separator Opacity="0" Width="5"/>

                                <TextBlock
                                    x:Name="tblockPeriod"
                                    Style="{StaticResource DefText13}"
                                    FontFamily="Franklin Gothic Medium"
                                    HorizontalAlignment="Left" VerticalAlignment="Top"/>
                            </StackPanel>

                            <StackPanel 
                                Orientation="Horizontal"
                                VerticalAlignment="Top"
                                HorizontalAlignment="Left"
                                Margin="73,60,0,0">
                                <Label 
                                    Style="{StaticResource TextZagolovokDashboard}"
                                    Content="Клиент:"
                                    Foreground="#A1A2A2"
                                    FontSize="13"
                                    Padding="0"
                                    HorizontalAlignment="Left" VerticalAlignment="Top"/>

                                <Separator Opacity="0" Width="5"/>

                                <TextBlock
                                    x:Name="tblockClientFIO"
                                    Style="{StaticResource DefText13}"
                                    FontFamily="Franklin Gothic Medium"
                                    HorizontalAlignment="Left" VerticalAlignment="Top"/>
                            </StackPanel>

                            <StackPanel 
                                Orientation="Horizontal"
                                VerticalAlignment="Top"
                                HorizontalAlignment="Left"
                                Margin="74,90,0,0">
                                <Label 
                                    Style="{StaticResource TextZagolovokDashboard}"
                                    Content="Статус:"
                                    Foreground="#A1A2A2"
                                    FontSize="13"
                                    Padding="0"
                                    HorizontalAlignment="Left" VerticalAlignment="Top"/>

                                <Separator Opacity="0" Width="5"/>

                                <TextBlock
                                    x:Name="tblockStatus"
                                    Style="{StaticResource DefText13}"
                                    FontFamily="Franklin Gothic Medium"
                                    HorizontalAlignment="Left" VerticalAlignment="Top"/>
                            </StackPanel>

                            <StackPanel 
                                Orientation="Horizontal"
                                VerticalAlignment="Top"
                                HorizontalAlignment="Left"
                                Margin="82,120,0,0">
                                <Label 
                                    Style="{StaticResource TextZagolovokDashboard}"
                                    Content="Итого:"
                                    Foreground="#A1A2A2"
                                    FontSize="13"
                                    Padding="0"
                                    HorizontalAlignment="Left" VerticalAlignment="Top"/>

                                <Separator Opacity="0" Width="5"/>

                                <TextBlock
                                    x:Name="tblockItogo"
                                    Style="{StaticResource DefText13}"
                                    FontFamily="Franklin Gothic Medium"
                                    HorizontalAlignment="Left" VerticalAlignment="Top"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
            </Grid>

            <customControls:ButtomWithBorder 
                x:Name="btnSave"
                Content="Сохранить"
                VerticalAlignment="Bottom"
                HorizontalAlignment="Center"
                Margin="0,0,0,20"
                Loaded="btnSave_Loaded"/>
        </Grid>
    </Border>
</Window>