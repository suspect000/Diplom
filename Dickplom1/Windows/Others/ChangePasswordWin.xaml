<Window x:Class="Dickplom1.Windows.Others.ChangePasswordWin"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Dickplom1.Windows.Others"
        xmlns:customControls="clr-namespace:CustomControlsForDiplomFramework;assembly=CustomControlsForDiplomFramework"
        WindowStyle="None"
        Background="Transparent"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        AllowsTransparency="True"
        VerticalAlignment="Center"
        mc:Ignorable="d"
        Title="OrdersNaturalPersonsAddWin" Height="500" Width="500">
    <Border
        Width="400" Height="400"
        CornerRadius="20">
        <Border.Background>
            <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0" MappingMode="RelativeToBoundingBox">
                <LinearGradientBrush.RelativeTransform>
                    <TransformGroup>
                        <ScaleTransform CenterY="0.5" CenterX="0.5"/>
                        <SkewTransform CenterX="0.5" CenterY="0.5"/>
                        <RotateTransform Angle="135" CenterX="0.5" CenterY="0.5"/>
                        <TranslateTransform/>
                    </TransformGroup>
                </LinearGradientBrush.RelativeTransform>
                <GradientStop Color="#C3C7D2"/>
                <GradientStop Color="#F7F7FA" Offset="1"/>
            </LinearGradientBrush>
        </Border.Background>
        <Border.Effect>
            <DropShadowEffect 
                BlurRadius="50" 
                ShadowDepth="10" 
                Direction="270"/>
        </Border.Effect>
        <Grid
            x:Name="mainGrid"
            Background="Transparent">
            <Grid 
                x:Name="gridFocus"
                Focusable="True"
                Width="1" Height="1"
                Background="Transparent">
            </Grid>

            <customControls:ButtonClose
                x:Name="btnClose"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="0,20,20,0"
                MouseLeftButtonUp="btnClose_MouseLeftButtonUp"/>

            <Label    
                Style="{StaticResource TextZagolovokDashboard}"
                Foreground="#636C7F"                    
                FontSize="25"
                Padding="0"
                Content="Смена пароля"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Margin="0,40,0,0"/>

            <Label    
                Style="{StaticResource TextZagolovokDashboard}"
                Foreground="Gray"                    
                FontSize="15"
                Padding="0"
                Content="Введите новый пароль"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Margin="49,120,0,0"/>

            <customControls:PasswordBodWithBorder
                x:Name="pbNewPassword"
                ToolTip="Название"
                Width="300"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Margin="0,150,0,0"
                Loaded="pbNewPassword_Loaded"
                GotFocus="pbNewPassword_GotFocus"
                LostFocus="pbNewPassword_LostFocus"/>

            <Label    
                Style="{StaticResource TextZagolovokDashboard}"
                Foreground="Gray"                    
                FontSize="15"
                Padding="0"
                Content="Повторите новый пароль"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Margin="49,210,0,0"/>

            <customControls:PasswordBodWithBorder
                x:Name="pbNewPasswordRepeat"
                ToolTip="Название"
                Width="300"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Margin="0,240,0,0"
                Loaded="pbNewPasswordRepeat_Loaded_1"
                GotFocus="pbNewPasswordRepeat_GotFocus"
                LostFocus="pbNewPasswordRepeat_LostFocus"/>

            <customControls:ButtomWithBorder 
                x:Name="btnSave"
                Content="Сохранить"
                VerticalAlignment="Bottom"
                HorizontalAlignment="Center"
                Margin="0,0,0,20"
                Loaded="btnSave_Loaded"/>
        </Grid>
    </Border>
</Window>
