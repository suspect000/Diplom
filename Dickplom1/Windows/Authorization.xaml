<Window x:Class="Dickplom1.Windows.Authorization"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Dickplom1.Windows"
        xmlns:customControls="clr-namespace:CustomControlsForDiplomFramework;assembly=CustomControlsForDiplomFramework"
        mc:Ignorable="d"
        WindowStyle="None"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Width="600" Height="800"
        Background="Transparent">
    <Border
        Background="White"
        BorderBrush="DarkSlateGray"
        BorderThickness="0"
        CornerRadius="20">
        <Grid>
            <customControls:ButtonClose
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="0,20,20,0"
                MouseLeftButtonUp="ButtonClose_MouseLeftButtonUp"/>
            <Border
                Width="450" Height="650"
                CornerRadius="20">
                <Border.Background>
                    <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0" MappingMode="RelativeToBoundingBox">
                        <LinearGradientBrush.RelativeTransform>
                            <TransformGroup>
                                <ScaleTransform CenterY="0.5" CenterX="0.5"/>
                                <SkewTransform CenterX="0.5" CenterY="0.5"/>
                                <RotateTransform Angle="135" CenterX="0.5" CenterY="0.5"/>
                                <TranslateTransform/>
                            </TransformGroup>
                        </LinearGradientBrush.RelativeTransform>
                        <GradientStop Color="#C3C7D2"/>
                        <GradientStop Color="#F7F7FA" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Border.Effect>
                    <DropShadowEffect
                        BlurRadius="100" 
                        ShadowDepth="10" 
                        Direction="270"/>
                </Border.Effect>
                <Grid>
                    <Image 
                        Source="/Resources/Images/MainWin/logoCyrcle.png"
                        Opacity="0.01"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        RenderOptions.BitmapScalingMode="HighQuality"
                        Margin="25,0,25,0">
                    </Image>
                    <StackPanel
                        Orientation="Vertical"
                        Margin="0,100,0,0"
                        VerticalAlignment="Top">
                        <Label 
                            Content="Авторизация"
                            Style="{StaticResource TextZagolovokDashboard}"
                            FontSize="36"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Top"
                            Padding="0"/>
                        <Separator Opacity="0" Height="10"/>
                        <Label 
                            Content="Введите данные своей учетной записи"
                            Style="{StaticResource TextZagolovokDashboard}"
                            FontSize="15"
                            Padding="0"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Top"/>
                    </StackPanel>
                    <StackPanel
                        Orientation="Vertical"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Width="350">

                        <StackPanel
                            Orientation="Vertical">
                            <Label
                                Content="Введите логин"
                                Style="{StaticResource TextZagolovokDashboard}"
                                Padding="7,0,0,0"/>
                            <Separator Opacity="0" Height="10"/>
                            <customControls:TextboxWithBorder         
                                x:Name="tboxLogin"
                                Width="350"
                                LostFocus="tboxName_LostFocus"
                                ToolTip="Логин"
                                Text="Логин"/>
                        </StackPanel>

                        <Separator Opacity="0" Height="30"/>

                        <StackPanel
                            Orientation="Vertical">
                            <Label
                                Content="Введите пароль"
                                Style="{StaticResource TextZagolovokDashboard}"
                                Padding="7,0,0,0"/>
                            <Separator Opacity="0" Height="10"/>
                            <customControls:PasswordBodWithBorder         
                                x:Name="pbPassword"
                                Width="350"
                                ToolTip="Пароль"
                                Password="Пароль"
                                Loaded="pbPassword_Loaded"
                                GotFocus="pbPassword_GotFocus"
                                LostFocus="pbPassword_LostFocus"/>
                        </StackPanel>
                    </StackPanel>
                    <customControls:ButtomWithBorder
                        Name="btnJoin"
                        Content="Войти"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Bottom"
                        Width="250"
                        Margin="0,0,0,50"
                        Loaded="ButtomWithBorder_Loaded"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
