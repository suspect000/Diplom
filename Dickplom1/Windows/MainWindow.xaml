<Window x:Class="Dickplom1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Dickplom1"
        mc:Ignorable="d"
        Title="ClientPro" 
        Height="980" Width="1540"
        Background="Transparent"
        WindowState="Normal"
        WindowStartupLocation="CenterScreen"
        AllowsTransparency="True"
        WindowStyle="None"
        ResizeMode="CanResize">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="20"/>
            <ColumnDefinition Width="280"/>
            <ColumnDefinition Width="20"/>
            <ColumnDefinition Width="1180"/>
            <ColumnDefinition Width="40"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        
        <Grid.RowDefinitions>
            <RowDefinition Height="129"/>
            <RowDefinition Height="821"/>
            <RowDefinition Height="30"/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <Border Background="{StaticResource MainBackgroundColor}"
                CornerRadius="20"
                BorderThickness="0"
                Grid.Column="0"
                Grid.ColumnSpan="7"
                Grid.Row="0"
                Grid.RowSpan="7">
        </Border>

        <Rectangle x:Name="MoveWin"
                   Fill="Transparent"
                   HorizontalAlignment="Stretch"
                   VerticalAlignment="Top"
                   Height="30" 
                   PreviewMouseLeftButtonDown="MoveWin_PreviewMouseLeftButtonDown"
                   Grid.ColumnSpan="7"/>

        <Image 
            Name="Logo"
            Width="150" Height="auto"
            VerticalAlignment="Center" HorizontalAlignment="Center" 
            Source="/Resources/Images/MainWin/LogoWhite.png" 
            RenderOptions.BitmapScalingMode="HighQuality"
            Grid.Row="0"
            Grid.Column="1"/>

        <StackPanel
            Grid.Column="3"
            HorizontalAlignment="Left" VerticalAlignment="Center"
            Orientation="Horizontal">
            <TextBlock
                Text="Отчеты"
                Style="{StaticResource DefText15}"/>
            <Image Source="/Resources/Images/MainWin/arrow.png"
                   Margin="10,0,0,0"
                   Name="ImgArrowDown"
                   Width="8"
                   Height="8"/>
        </StackPanel>

        <Grid 
            Grid.Column="3"
            Margin="0,0,200,0"
            Width="228" Height="57"
            HorizontalAlignment="Right">

            <TextBox
                Text="Найти"
                Width="228" Height="57"
                HorizontalAlignment="Right"
                Style="{StaticResource SearchStyle}"/>
            
            <Image Source="/Resources/Images/MainWin/lupa.png"
                   RenderOptions.BitmapScalingMode="HighQuality"
                   Height="15"
                   Width="13"
                   HorizontalAlignment="Left"
                   Margin="25,0,0,0"/>
        </Grid>
    </Grid>
</Window>
