<Window x:Class="Dickplom1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Dickplom1"
        mc:Ignorable="d"
        Title="ClientPro" 
        Height="1000" Width="1540"
        MinWidth="1560" MinHeight="1000"
        MaxWidth="2000" MaxHeight="2000"
        WindowState="Normal"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        MouseDown="Window_MouseDown"
        Background="{StaticResource MainBackgroundColor}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="20"/>
            <ColumnDefinition Width="280"/>
            <ColumnDefinition Width="20"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="40"/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="129"/>
            <RowDefinition/>
            <RowDefinition Height="30"/>
        </Grid.RowDefinitions>

        <!--Header-->
        <Rectangle x:Name="HidenRect"
                   Fill="Transparent"
                   HorizontalAlignment="Stretch"
                   VerticalAlignment="Top"
                   Height="30" 
                   Focusable="True"
                   Grid.ColumnSpan="7"/>

        <Image 
            Name="Logo"
            Width="150" Height="auto"
            VerticalAlignment="Center" HorizontalAlignment="Center" 
            Source="/Resources/Images/MainWin/LogoWhite.png" 
            RenderOptions.BitmapScalingMode="HighQuality"
            Grid.Row="0"
            Grid.Column="1"/>

        <StackPanel
            x:Name="spReports"
            Grid.Column="3"
            HorizontalAlignment="Left" VerticalAlignment="Center"
            Orientation="Horizontal"
            Height="30"
            MouseEnter="StackPanel_MouseEnter"
            MouseLeave="StackPanel_MouseLeave"
            MouseLeftButtonUp="spReports_MouseLeftButtonUp">

            <TextBlock
                Text="Отчеты"
                Style="{StaticResource DefText15}"/>

            <Rectangle Opacity="0" Fill="Transparent" Width="25"/>

            <Image Source="/Resources/Images/MainWin/arrow.png"
                   RenderOptions.BitmapScalingMode="HighQuality"
                   Name="ImgReportsArrowDown"
                   Width="8"
                   Height="30"
                   Margin="-20,0,0,0"/>
        </StackPanel>

        <Grid 
            Name="gridSelectReportsToMake"
            Grid.Column="3"
            Grid.Row="0" Grid.RowSpan="2"
            Panel.ZIndex="1"
            Width="370" Height="74"
            Background="Transparent"
            Visibility="Collapsed"
            HorizontalAlignment="Left" VerticalAlignment="Top"
            Margin="0,90,0,0">

            <Border BorderBrush="#C3C7D2"
                    Background="White"
                    BorderThickness="1"
                    CornerRadius="5">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="15" Opacity="0.15" ShadowDepth="15" Direction="270"/>
                </Border.Effect>
            </Border>
            <StackPanel 
                x:Name="spReportsSelect"
                Orientation="Vertical">

                <Button 
                    x:Name="btnMakeReportOrders"
                    Style="{StaticResource BtnClearBackground}"
                    Height="37"
                    Content="Сформировать отчет по продажам"
                    MouseEnter="btnMakeReportOrders_MouseEnter"
                    MouseLeave="btnMakeReportOrders_MouseLeave"/>

                <Button 
                    x:Name="btnMakeReportStaff"
                    Style="{StaticResource BtnClearBackground}"
                    Height="37"
                    Content="Сформировать отчет по сотрудникам"
                    MouseEnter="btnMakeReportStaff_MouseEnter"
                    MouseLeave="btnMakeReportStaff_MouseLeave"/>

            </StackPanel>

        </Grid>

        <StackPanel
            Grid.Column="3"
            Orientation="Horizontal"
            HorizontalAlignment="Right" VerticalAlignment="Center"
            Width="auto" Height="57">
            <Grid 
                Name="gridSearch"
                Margin="0,0,15,0"
                Width="auto" Height="57"
                HorizontalAlignment="Right">

                <TextBox
                    Name="tbSearch"
                    Text="Найти"
                    Width="228" Height="57"
                    BorderThickness="1"
                    BorderBrush="Transparent"
                    HorizontalAlignment="Right"
                    Style="{StaticResource SearchStyle}" 
                    GotFocus="TextBox_GotFocus" 
                    LostFocus="tbSearch_LostFocus"
                    TextWrapping="NoWrap"
                    MouseEnter="tbSearch_MouseEnter"
                    MouseLeave="tbSearch_MouseLeave"/>

                <Image Source="/Resources/Images/MainWin/lupa.png"
                    Name="imgLupa"
                    RenderOptions.BitmapScalingMode="HighQuality"
                    Height="15"
                    Width="13"
                    HorizontalAlignment="Left"
                    Margin="25,0,0,0"
                    IsHitTestVisible="False"/>
            </Grid>

            <Grid
                x:Name="gridNotification"
                Grid.Column="3"
                Margin="0,0,15,0"
                Width="auto" Height="auto"
                VerticalAlignment="Center"
                HorizontalAlignment="Right">

                <Button
                    Name="btnNotification"
                    Width="54" Height="57"
                    
                    BorderThickness="1"
                    
                    Style="{StaticResource BtnCircle}" 
                    
                    MouseEnter="btnNotification_MouseEnter"
                    MouseLeave="btnNotification_MouseLeave"
                    Click="btnNotification_Click">

                    <Image 
                        Source="/Resources/Images/MainWin/Notification.png"
                        RenderOptions.BitmapScalingMode="HighQuality"
                        IsHitTestVisible="False"
                        Width="20" Height="20"/>
                </Button>
            </Grid>
            <Grid
                x:Name="gridProfile"
                Grid.Column="3"
                Width="auto" Height="auto"
                VerticalAlignment="Center"
                HorizontalAlignment="Right">

                <Button
                    Name="btnProfile"
                    Content="ВС"
                    Width="54" Height="57"
                    BorderThickness="1"
                    Style="{StaticResource BtnCircle}"
                    FontFamily="Proletarsk" FontSize="15"
                    MouseEnter="btnProfile_MouseEnter" MouseLeave="btnProfile_MouseLeave" 
                    Click="btnProfile_Click"/>
            </Grid>
        </StackPanel>
        <!--/Header-->

        <!--Navigation-->
        <Grid
            x:Name="gridNavigation"
            Grid.Column="1"
            Grid.Row="1"
            Width="280" Height="516"
            VerticalAlignment="Top">

            <Border 
                Background="{StaticResource OtherBackground}"
                CornerRadius="20">
            </Border>



            <StackPanel
                Width="auto" Height="auto"
                HorizontalAlignment="Center" VerticalAlignment="Top">

                <Separator Opacity="0" Height="20"/>

                <Grid
                    x:Name="gridDashboard"
                    Width="224" Height="50"
                    Background="Transparent"
                    MouseEnter="gridDashboard_MouseEnter"
                    MouseLeave="gridDashboard_MouseLeave">

                    <Border
                        x:Name="borderDashboard"
                        CornerRadius="15"
                        BorderThickness="1"
                        Background="Transparent"
                        BorderBrush="Transparent"/>

                    <StackPanel 
                        Orientation="Horizontal">

                        <Image 
                            Source="..//Resources/Images/MainWin/Navigation/IcnAnalBlue.png"
                            RenderOptions.BitmapScalingMode="HighQuality"
                            Width="23"
                            HorizontalAlignment="Left" VerticalAlignment="Center"
                            Margin="10,0,0,0"/>

                        <TextBlock 
                            Text="Аналитика"
                            Style="{StaticResource DefText14}"
                            VerticalAlignment="Center" HorizontalAlignment="Left"
                            Margin="20,0,0,0"/>

                    </StackPanel>
                </Grid>

                <Separator Opacity="0" Height="15"/>

                <Grid
                    x:Name="gridClients"
                    Width="224" Height="50"
                    Background="Transparent"
                    MouseEnter="gridClients_MouseEnter"
                    MouseLeave="gridClients_MouseLeave"
                    MouseLeftButtonDown="gridClients_MouseLeftButtonDown">

                    <Border
                        x:Name="borderClients"
                        CornerRadius="15"
                        BorderThickness="1" 
                        BorderBrush="Transparent" 
                        Background="Transparent"/>

                    <StackPanel 
                        Orientation="Horizontal">

                        <Image 
                            Source="..//Resources/Images/MainWin/Navigation/IcnClients.png"
                            RenderOptions.BitmapScalingMode="HighQuality"
                            Width="23"
                            HorizontalAlignment="Left" VerticalAlignment="Center"
                            Margin="10,0,0,0"/>

                        <TextBlock 
                            Text="Клиенты"
                            Style="{StaticResource DefText14}"
                            VerticalAlignment="Center" HorizontalAlignment="Left"
                            Margin="20,0,0,0"/>

                        <Image 
                            Name="imgArrowClients"
                            Source="..//Resources/Images/MainWin/arrow.png"
                            RenderOptions.BitmapScalingMode="HighQuality"
                            Width="10"
                            VerticalAlignment="Center"
                            Margin="90,0"/>
                    </StackPanel>
                </Grid>

                <StackPanel 
                    x:Name="SPClientsItems"
                    Orientation="Vertical"
                    Height="auto"
                    Margin="0,0,0,0"
                    Visibility="Collapsed">

                    <Separator Opacity="0" Height="15"/>

                    <Grid
                        x:Name="gridClientsItem1"
                        Width="224" Height="50"
                        Background="Transparent"
                        MouseEnter="gridClientsItem1_MouseEnter"
                        MouseLeave="gridClientsItem1_MouseLeave">

                        <Border
                            x:Name="borderClientsItem1"
                            CornerRadius="15"
                            Width="200"
                            HorizontalAlignment="Right"
                            BorderThickness="1" 
                            BorderBrush="Transparent" 
                            Background="Transparent"/>

                        <Image 
                            Source="..//Resources/Images/MainWin/Navigation/topicLine.png"
                            RenderOptions.BitmapScalingMode="HighQuality"
                            Width="10"
                            HorizontalAlignment="Left" VerticalAlignment="Center"
                            Margin="5,0,0,9"/>

                        <StackPanel 
                            Orientation="Horizontal" 
                            HorizontalAlignment="Left"
                            Width="200"
                            Margin="24,0">

                            <Image 
                                Source="..//Resources/Images/MainWin/Navigation/IcnClients.png"
                                RenderOptions.BitmapScalingMode="HighQuality"
                                Width="23"
                                HorizontalAlignment="Left" VerticalAlignment="Center"
                                Margin="10,0,0,0"/>

                            <TextBlock 
                                Text="Клиенты пример"
                                Style="{StaticResource DefText14}"
                                VerticalAlignment="Center" HorizontalAlignment="Left"
                                Margin="20,0,0,0"/>

                        </StackPanel>
                    </Grid>

                    <Separator Opacity="0" Height="15"/>

                    <Grid
                        x:Name="gridClientsItem2"
                        Width="224" Height="50"
                        Background="Transparent"
                        MouseEnter="gridClientsItem2_MouseEnter"
                        MouseLeave="gridClientsItem2_MouseLeave">

                        <Border
                            x:Name="borderClientsItem2"
                            CornerRadius="15"
                            Width="200"
                            HorizontalAlignment="Right"
                            BorderThickness="1" 
                            BorderBrush="Transparent" 
                            Background="Transparent"/>

                        <Image 
                            Source="..//Resources/Images/MainWin/Navigation/topicLine.png"
                            RenderOptions.BitmapScalingMode="HighQuality"
                            Width="10"
                            HorizontalAlignment="Left" VerticalAlignment="Center"
                            Margin="5,0,0,9"/>

                        <StackPanel 
                            Orientation="Horizontal" 
                            HorizontalAlignment="Left"
                            Width="200"
                            Margin="24,0">

                            <Image 
                                Source="..//Resources/Images/MainWin/Navigation/IcnClients.png"
                                RenderOptions.BitmapScalingMode="HighQuality"
                                Width="23"
                                HorizontalAlignment="Left" VerticalAlignment="Center"
                                Margin="10,0,0,0"/>

                            <TextBlock 
                                Text="Клиенты пример"
                                Style="{StaticResource DefText14}"
                                VerticalAlignment="Center" HorizontalAlignment="Left"
                                Margin="20,0,0,0"/>

                        </StackPanel>
                    </Grid>
                </StackPanel>

                <Separator Opacity="0" Height="15"/>

                <Grid
                    x:Name="gridOrders"
                    Width="224" Height="50"
                    Background="Transparent"
                    MouseEnter="gridOrders_MouseEnter"
                    MouseLeave="gridOrders_MouseLeave"
                    MouseLeftButtonDown="gridOrders_MouseLeftButtonDown">

                    <Border
                        x:Name="borderOrders"
                        CornerRadius="15"
                        BorderThickness="1" 
                        BorderBrush="Transparent" 
                        Background="Transparent"/>

                    <StackPanel 
                        Orientation="Horizontal">

                        <Image 
                            Source="..//Resources/Images/MainWin/Navigation/IcnOrder.png"
                            RenderOptions.BitmapScalingMode="HighQuality"
                            Width="23"
                            HorizontalAlignment="Left" VerticalAlignment="Center"
                            Margin="10,0,0,0"/>

                        <TextBlock 
                            Text="Заказы"
                            Style="{StaticResource DefText14}"
                            VerticalAlignment="Center" HorizontalAlignment="Left"
                            Margin="20,0,0,0"/>

                        <Image 
                            Name="imgArrowOrders"
                            Source="..//Resources/Images/MainWin/arrow.png"
                            RenderOptions.BitmapScalingMode="HighQuality"
                            Width="10"
                            VerticalAlignment="Center"
                            Margin="99,0"/>
                    </StackPanel>
                </Grid>

                <StackPanel 
                    x:Name="SPOrdersItems"
                    Orientation="Vertical"
                    Height="auto"
                    Margin="0,0,0,0"
                    Visibility="Collapsed">

                    <Separator Opacity="0" Height="15"/>

                    <Grid
                        x:Name="gridOrdersItem1"
                        Width="224" Height="50"
                        Background="Transparent"
                        MouseEnter="gridOrdersItem1_MouseEnter"
                        MouseLeave="gridOrdersItem1_MouseLeave">

                        <Border
                            x:Name="borderOrdersItem1"
                            CornerRadius="15"
                            Width="200"
                            HorizontalAlignment="Right"
                            BorderThickness="1" 
                            BorderBrush="Transparent" 
                            Background="Transparent"/>

                        <Image 
                            Source="..//Resources/Images/MainWin/Navigation/topicLine.png"
                            RenderOptions.BitmapScalingMode="HighQuality"
                            Width="10"
                            HorizontalAlignment="Left" VerticalAlignment="Center"
                            Margin="5,0,0,9"/>

                        <StackPanel 
                            Orientation="Horizontal" 
                            HorizontalAlignment="Left"
                            Width="200"
                            Margin="24,0">

                            <Image 
                                Source="..//Resources/Images/MainWin/Navigation/IcnEdit.png"
                                RenderOptions.BitmapScalingMode="HighQuality"
                                Width="23"
                                HorizontalAlignment="Left" VerticalAlignment="Center"
                                Margin="10,0,0,0"/>

                            <TextBlock 
                                Text="Редактирование"
                                Style="{StaticResource DefText14}"
                                VerticalAlignment="Center" HorizontalAlignment="Left"
                                Margin="20,0,0,0"/>

                        </StackPanel>
                    </Grid>

                    <Separator Opacity="0" Height="15"/>

                    <Grid
                        x:Name="gridOrdersItem2"
                        Width="224" Height="50"
                        Background="Transparent"
                        MouseEnter="gridOrdersItem2_MouseEnter"
                        MouseLeave="gridOrdersItem2_MouseLeave">

                        <Border
                            x:Name="borderOrdersItem2"
                            CornerRadius="15"
                            Width="200"
                            HorizontalAlignment="Right"
                            BorderThickness="1" 
                            BorderBrush="Transparent" 
                            Background="Transparent"/>

                        <Image 
                            Source="..//Resources/Images/MainWin/Navigation/topicLine.png"
                            RenderOptions.BitmapScalingMode="HighQuality"
                            Width="10"
                            HorizontalAlignment="Left" VerticalAlignment="Center"
                            Margin="5,0,0,9"/>

                        <StackPanel 
                            Orientation="Horizontal" 
                            HorizontalAlignment="Left"
                            Width="200"
                            Margin="24,0">

                            <Image 
                                Source="..//Resources/Images/MainWin/Navigation/IcnStatus.png"
                                RenderOptions.BitmapScalingMode="HighQuality"
                                Width="23"
                                HorizontalAlignment="Left" VerticalAlignment="Center"
                                Margin="10,0,0,0"/>

                            <TextBlock 
                                Text="Статусы"
                                Style="{StaticResource DefText14}"
                                VerticalAlignment="Center" HorizontalAlignment="Left"
                                Margin="20,0,0,0"/>

                        </StackPanel>
                    </Grid>
                </StackPanel>

                <Separator Opacity="0" Height="15"/>

                <Grid
                    x:Name="gridServices"
                    Width="224" Height="50"
                    Background="Transparent"
                    MouseEnter="gridServices_MouseEnter"
                    MouseLeave="gridServices_MouseLeave"
                    MouseLeftButtonDown="gridServices_MouseLeftButtonDown">

                    <Border
                        x:Name="borderServices"
                        CornerRadius="15"
                        BorderThickness="1" 
                        BorderBrush="Transparent" 
                        Background="Transparent"/>

                    <StackPanel 
                        Orientation="Horizontal">

                        <Image 
                            Source="..//Resources/Images/MainWin/Navigation/IcnServices.png"
                            RenderOptions.BitmapScalingMode="HighQuality"
                            Width="23"
                            HorizontalAlignment="Left" VerticalAlignment="Center"
                            Margin="10,0,0,0"/>

                        <TextBlock 
                            Text="Услуги"
                            Style="{StaticResource DefText14}"
                            VerticalAlignment="Center" HorizontalAlignment="Left"
                            Margin="20,0,0,0"/>

                        <Image 
                            Name="imgArrowServices"
                            Source="..//Resources/Images/MainWin/arrow.png"
                            RenderOptions.BitmapScalingMode="HighQuality"
                            Width="10"
                            VerticalAlignment="Center"
                            Margin="99.2,0"/>
                    </StackPanel>
                </Grid>

                <StackPanel 
                    x:Name="SPServicesItems"
                    Orientation="Vertical"
                    Height="auto"
                    Margin="0,0,0,0"
                    Visibility="Collapsed">

                    <Separator Opacity="0" Height="15"/>

                    <Grid
                        x:Name="gridServicesItem1"
                        Width="224" Height="50"
                        Background="Transparent"
                        MouseEnter="gridServicesItem1_MouseEnter"
                        MouseLeave="gridServicesItem1_MouseLeave">

                        <Border
                            x:Name="borderServicesItem1"
                            CornerRadius="15"
                            Width="200"
                            HorizontalAlignment="Right"
                            BorderThickness="1" 
                            BorderBrush="Transparent" 
                            Background="Transparent"/>

                        <Image 
                            Source="..//Resources/Images/MainWin/Navigation/topicLine.png"
                            RenderOptions.BitmapScalingMode="HighQuality"
                            Width="10"
                            HorizontalAlignment="Left" VerticalAlignment="Center"
                            Margin="5,0,0,9"/>

                        <StackPanel 
                            Orientation="Horizontal" 
                            HorizontalAlignment="Left"
                            Width="200"
                            Margin="24,0">

                            <Image 
                                Source="..//Resources/Images/MainWin/Navigation/IcnServices.png"
                                RenderOptions.BitmapScalingMode="HighQuality"
                                Width="23"
                                HorizontalAlignment="Left" VerticalAlignment="Center"
                                Margin="10,0,0,0"/>

                            <TextBlock 
                                Text="Пример услуги"
                                Style="{StaticResource DefText14}"
                                VerticalAlignment="Center" HorizontalAlignment="Left"
                                Margin="20,0,0,0"/>

                        </StackPanel>
                    </Grid>

                    <Separator Opacity="0" Height="15"/>

                    <Grid
                        x:Name="gridServicesItem2"
                        Width="224" Height="50"
                        Background="Transparent"
                        MouseEnter="gridServicesItem2_MouseEnter"
                        MouseLeave="gridServicesItem2_MouseLeave">

                        <Border
                            x:Name="borderServicesItem2"
                            CornerRadius="15"
                            Width="200"
                            HorizontalAlignment="Right"
                            BorderThickness="1" 
                            BorderBrush="Transparent" 
                            Background="Transparent"/>

                        <Image 
                            Source="..//Resources/Images/MainWin/Navigation/topicLine.png"
                            RenderOptions.BitmapScalingMode="HighQuality"
                            Width="10"
                            HorizontalAlignment="Left" VerticalAlignment="Center"
                            Margin="5,0,0,9"/>

                        <StackPanel 
                            Orientation="Horizontal" 
                            HorizontalAlignment="Left"
                            Width="200"
                            Margin="24,0">

                            <Image 
                                Source="..//Resources/Images/MainWin/Navigation/IcnServices.png"
                                RenderOptions.BitmapScalingMode="HighQuality"
                                Width="23"
                                HorizontalAlignment="Left" VerticalAlignment="Center"
                                Margin="10,0,0,0"/>

                            <TextBlock 
                                Text="Пример услуги"
                                Style="{StaticResource DefText14}"
                                VerticalAlignment="Center" HorizontalAlignment="Left"
                                Margin="20,0,0,0"/>

                        </StackPanel>
                    </Grid>
                </StackPanel>

                <Separator Opacity="0" Height="15"/>

                <Grid
                    x:Name="gridStaff"
                    Width="224" Height="50"
                    Background="Transparent"
                    MouseEnter="gridStaff_MouseEnter"
                    MouseLeave="gridStaff_MouseLeave">

                    <Border
                        x:Name="borderStaff"
                        CornerRadius="15"
                        BorderThickness="1"
                        Background="Transparent"
                        BorderBrush="Transparent"/>

                    <StackPanel 
                        Orientation="Horizontal">

                        <Image 
                            Source="..//Resources/Images/MainWin/Navigation/IcnStaff.png"
                            RenderOptions.BitmapScalingMode="HighQuality"
                            Width="23"
                            HorizontalAlignment="Left" VerticalAlignment="Center"
                            Margin="10,0,0,0"/>

                        <TextBlock 
                            Text="Сотрудники"
                            Style="{StaticResource DefText14}"
                            VerticalAlignment="Center" HorizontalAlignment="Left"
                            Margin="20,0,0,0"/>

                    </StackPanel>
                </Grid>
            </StackPanel>
        </Grid>
        <!--/Navigation-->

        <!--Закрепленные задачи-->
        <Grid
            x:Name="gridZakrep"
            Grid.Column="1"
            Grid.Row="1"
            Width="280" Height="279"
            VerticalAlignment="Top"
            Margin="0,546,0,0">

            <Border 
                Background="{StaticResource OtherBackground}"
                CornerRadius="20">
            </Border>

            <TextBlock 
                    Text="Закрепленные задачи"
                    Style="{StaticResource DefText15}"
                    VerticalAlignment="Top" HorizontalAlignment="Center"
                    Margin="0,20,0,0"/>

            <StackPanel 
                Orientation="Vertical"
                HorizontalAlignment="Center" VerticalAlignment="Center">

                <TextBlock 
                    Text="Здесь пока пусто"
                    Style="{StaticResource DefText13}"
                    VerticalAlignment="Center" HorizontalAlignment="Center"
                    Margin="0,0,0,0"/>

                <Separator Opacity="0" Height="10"/>

                <StackPanel
                    x:Name="spZakrepGoToOrders"
                    Orientation="Horizontal" 
                    Opacity="0.5"
                    MouseEnter="spZakrepGoToOrders_MouseEnter"
                    MouseLeave="spZakrepGoToOrders_MouseLeave">

                    <TextBlock 
                        Text="Перейти в заказы"
                        Style="{StaticResource DefText13}"
                        VerticalAlignment="Top" HorizontalAlignment="Center"/>

                    <Separator Opacity="0" Width="5"/>

                    <Image 
                        Source="..//Resources/Images/MainWin/Navigation/imgArrowRight.png"
                        RenderOptions.BitmapScalingMode="HighQuality"
                        Width="15"
                        HorizontalAlignment="Left" VerticalAlignment="Center"/>

                </StackPanel>
            </StackPanel>
        </Grid>
        <!--/Закрепленные задачи-->

        <!--Уведомления-->
        <Grid
            Name="gridNotifications"
            Grid.Row="0"
            Grid.Column="3"
            Grid.RowSpan="2"
            Panel.ZIndex="1"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            Visibility="Collapsed"
            Width="300" Height="350"
            Margin="0,115,69,0">

            <Border CornerRadius="20"
                    Background="#F5F6F8">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="50" ShadowDepth="0" Opacity="0.5"/>
                </Border.Effect>
            </Border>

            <TextBlock 
                    Text="Уведомления"
                    Style="{StaticResource DefText15}"
                    VerticalAlignment="Top" HorizontalAlignment="Center"
                    Margin="0,20,0,0"/>

            <TextBlock 
                    Text="Здесь пока пусто"
                    Style="{StaticResource DefText13}"
                    VerticalAlignment="Center" HorizontalAlignment="Center"/>

        </Grid>
        <!--/Уведомления-->

        <!--Минипрофиль-->
        <Grid
            Name="gridMiniProfile"
            Grid.Row="0"
            Grid.Column="3"
            Grid.RowSpan="2"
            Panel.ZIndex="1"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            Visibility="Collapsed"
            Width="300" Height="300"
            Margin="0,115,0,0">

            <Border CornerRadius="20"
                    Background="#F5F6F8">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="50" ShadowDepth="0" Opacity="0.5"/>
                </Border.Effect>
            </Border>

            <StackPanel 
                Orientation="Horizontal"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Margin="20,20">

                <Button 
                    x:Name="btnMiniProfile"
                    Style="{StaticResource BtnCircle}"
                    Background="#E2E5F2"
                    Content="ВС"
                    FontSize="18"
                    Width="90" Height="90"
                    HorizontalAlignment="Left" VerticalAlignment="Top"/>

                <Separator 
                    Opacity="0" 
                    Height="50" Width="20"
                    VerticalAlignment="Center"/>

                <StackPanel 
                    Orientation="Vertical"
                    HorizontalAlignment="Left" VerticalAlignment="Center">

                    <TextBlock
                        Text="Менеджер"
                        Style="{StaticResource DefText15}"/>

                    <Separator Opacity="0" Height="7"/>

                    <TextBlock
                        Text="Владислав С."
                        Style="{StaticResource DefText18}"/>

                </StackPanel>
            </StackPanel>

            <Line 
                Stroke="#E2E5F2"
                X1="242"
                X2="0"
                Y1="0"
                Y2="0"
                HorizontalAlignment="Center" VerticalAlignment="Top"
                Margin="0,136,0,0"/>

            <StackPanel 
                Orientation="Vertical"
                VerticalAlignment="Top"
                HorizontalAlignment="Center"
                Margin="0,151,0,0">

                <Grid
                    x:Name="gridWindowThemes"
                    Width="242" Height="50"
                    Background="Transparent"
                    MouseLeftButtonUp="gridWindowThemes_MouseLeftButtonUp"
                    MouseEnter="gridMiniProfileWindowThemes_MouseEnter"
                    MouseLeave="gridMiniProfileWindowThemes_MouseLeave">

                    <Border
                        x:Name="borderWindowThemes"
                        CornerRadius="15"
                        BorderThickness="1"
                        Background="Transparent"
                        BorderBrush="Transparent"/>

                    <StackPanel 
                        Orientation="Horizontal">

                        <Image 
                            Source="..//Resources/Images/MainWin/MiniProfile/IcnLuna.png"
                            RenderOptions.BitmapScalingMode="HighQuality"
                            Width="20"
                            IsHitTestVisible="False"
                            HorizontalAlignment="Left" VerticalAlignment="Center"
                            Margin="10,0,0,0"/>

                        <TextBlock 
                            Text="Внешний вид"
                            Style="{StaticResource DefText14}"
                            IsHitTestVisible="False"
                            VerticalAlignment="Center" HorizontalAlignment="Left"
                            Margin="25,0,0,0"/>

                    </StackPanel>
                </Grid>

                <Separator Opacity="0" Focusable="False" Height="15"/>

                <Grid
                    x:Name="gridMiniProfileExit"
                    Width="242" Height="50"
                    Background="Transparent"
                    MouseEnter="gridMiniProfileExit_MouseEnter"
                    MouseLeave="gridMiniProfileExit_MouseLeave">

                    <Border
                        x:Name="borderMiniProfileExit"
                        CornerRadius="15"
                        BorderThickness="1"
                        Background="Transparent"
                        BorderBrush="Transparent"/>

                    <StackPanel 
                        Orientation="Horizontal">

                        <Image 
                            Source="..//Resources/Images/MainWin/MiniProfile/IcnExit.png"
                            RenderOptions.BitmapScalingMode="HighQuality"
                            Width="20"
                            HorizontalAlignment="Left" VerticalAlignment="Center"
                            Margin="10,0,0,0"/>

                        <TextBlock 
                            Text="Выход"
                            Style="{StaticResource DefText14}"
                            VerticalAlignment="Center" HorizontalAlignment="Left"
                            Margin="25,0,0,0"/>

                    </StackPanel>
                </Grid>
            </StackPanel>

            <Grid
                x:Name="gridSelectWindowThemes"
                Width="242" Height="100"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Visibility="Collapsed"
                Margin="0,0,0,100">

                <Border 
                    CornerRadius="20"
                    Background="White"
                    BorderBrush="{StaticResource SelectedBorder}"
                    BorderThickness="1"/>

                <Grid
                    x:Name="gridSetWhiteTheme"
                    Width="242" Height="50"
                    VerticalAlignment="Top"
                    Background="Transparent"
                    MouseEnter="gridSetWhiteTheme_MouseEnter"
                    MouseLeave="gridSetWhiteTheme_MouseLeave"
                    MouseLeftButtonUp="gridSetWhiteTheme_MouseLeftButtonUp">

                    <Border
                        x:Name="borderSetWhiteTheme"
                        CornerRadius="21"
                        BorderThickness="0"
                        Opacity="0.5"
                        BorderBrush="Transparent"
                        Background="Transparent"/>

                    <StackPanel 
                        Orientation="Horizontal">

                        <Image 
                            Source="..//Resources/Images/MainWin/MiniProfile/IcnSun.png"
                            RenderOptions.BitmapScalingMode="HighQuality"
                            Width="20"
                            HorizontalAlignment="Left" VerticalAlignment="Center"
                            Margin="10,0,0,0"/>

                        <TextBlock 
                            Text="Светлая тема"
                            Style="{StaticResource DefText14}"
                            VerticalAlignment="Center" HorizontalAlignment="Left"
                            Margin="25,0,0,0"/>
                    </StackPanel>

                    <RadioButton 
                        x:Name="rbtnWhiteTheme"
                        GroupName="rbtnsWindowsThemes"
                        Style="{StaticResource RaddioButtonCheck}" 
                        Width="15" Height="20" 
                        IsChecked="False"
                        HorizontalAlignment="Right" VerticalAlignment="Center"
                        Margin="0,0,20,0">
                        <RadioButton.Content>
                            <Image 
                                Source="/Resources/Images/MainWin/MiniProfile/ImgCheck.png"
                                RenderOptions.BitmapScalingMode="HighQuality"/>
                        </RadioButton.Content>
                    </RadioButton>

                </Grid>

                <Grid
                    x:Name="gridSetBlackTheme"
                    Width="242" Height="50"
                    VerticalAlignment="Bottom"
                    Background="Transparent"
                    MouseEnter="gridSetBlackTheme_MouseEnter"
                    MouseLeave="gridSetBlackTheme_MouseLeave"
                    MouseLeftButtonUp="gridSetBlackTheme_MouseLeftButtonUp">

                    <Border
                        x:Name="borderSetBlackTheme"
                        CornerRadius="21"
                        BorderThickness="0"
                        Opacity="0.5"
                        BorderBrush="Transparent"
                        Background="Transparent"/>

                    <StackPanel 
                        Orientation="Horizontal">

                        <Image 
                            Source="..//Resources/Images/MainWin/MiniProfile/IcnLuna.png"
                            RenderOptions.BitmapScalingMode="HighQuality"
                            Width="20"
                            HorizontalAlignment="Left" VerticalAlignment="Center"
                            Margin="10,0,0,0"/>

                        <TextBlock 
                            Text="Темная тема"
                            Style="{StaticResource DefText14}"
                            VerticalAlignment="Center" HorizontalAlignment="Left"
                            Margin="25,0,0,0"/>

                    </StackPanel>
                    <RadioButton 
                        x:Name="rbtnBlackTheme"
                        GroupName="windowsThemes"
                        Style="{StaticResource RaddioButtonCheck}" 
                        Width="15" Height="20" 
                        IsChecked="False"
                        HorizontalAlignment="Right" VerticalAlignment="Center"
                        Margin="0,0,20,0">
                        <RadioButton.Content>
                            <Image 
                                Source="/Resources/Images/MainWin/MiniProfile/ImgCheck.png"
                                RenderOptions.BitmapScalingMode="HighQuality"/>
                        </RadioButton.Content>
                    </RadioButton>
                </Grid>

            </Grid>

        </Grid>
        <!--/Минипрофиль-->


        <!--Основное наполнение-->
            <Border 
                Grid.Column="3"
                Grid.Row="1"
                VerticalAlignment="Top"
                HorizontalAlignment="Stretch"
                Background="{StaticResource OtherBackground}"
                CornerRadius="20"
                MinWidth="1180"
                Height="825">

                <Frame
                    x:Name="MainFrame"
                    Grid.Column="3"
                    Grid.Row="1"
                    VerticalAlignment="Top"
                    HorizontalAlignment="Stretch"
                    MinWidth="1180"
                    NavigationUIVisibility="Hidden"
                    Height="825">

                </Frame>
            </Border>
        
        <ScrollViewer 
            Grid.Column="4" Grid.Row="1"
            HorizontalAlignment="Right"
            Margin="5,0"
            VerticalAlignment="Stretch"
            Style="{StaticResource VerticalScrollViewer}"/>
        <!--/Основное наполнение-->

    </Grid>
</Window>
