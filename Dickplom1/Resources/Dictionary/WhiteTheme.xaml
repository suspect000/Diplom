<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--Цвета белой темы-->
    <SolidColorBrush x:Key="MainBackgroundColor" Color="White"/>
    <SolidColorBrush x:Key="MainTextForeground" Color="#636C7F"/>
    <SolidColorBrush x:Key="OtherBackground" Color="#F6F6F8"/>
    <SolidColorBrush x:Key="SelectedBorder" Color="#9C9FA6"/>
    <SolidColorBrush x:Key="SelectedItem" Color="#C3C7D2"/>
    <SolidColorBrush x:Key="PlitkaBackground" Color="#ECEDF1"/>
    <!---->

    <!--Стиль для обыного текста 18pt -->
    <Style x:Key="DefText18" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource MainTextForeground}"/>
        <Setter Property="FontFamily" Value="Proletarsk"/>
        <Setter Property="FontSize" Value="18"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <!---->

    <!--Стиль для обыного текста 15pt -->
    <Style x:Key="DefText15" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource MainTextForeground}"/>
        <Setter Property="FontFamily" Value="Proletarsk"/>
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <!---->

    
    <!--Стиль для обыного текста 14pt -->
    <Style x:Key="DefText14" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource MainTextForeground}"/>
        <Setter Property="FontFamily" Value="Proletarsk"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <!---->

    
    <!--Стиль для обыного текста 13pt -->
    <Style x:Key="DefText13" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource MainTextForeground}"/>
        <Setter Property="FontFamily" Value="Proletarsk"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <!---->


    <!--Стиль для поисковика -->
    <Style x:Key="SearchStyle" TargetType="TextBox">
        <Setter Property="Foreground" Value="{StaticResource MainTextForeground}"/>
        <Setter Property="FontFamily" Value="Proletarsk"/>
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="Background" Value="{StaticResource OtherBackground}"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate x:Name="controlTemplate" TargetType="TextBox">
                    <Border Name="borderForTextBox"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        Background="{TemplateBinding Background}"
                        CornerRadius="25"
                        Padding="45,0">
                        <ScrollViewer x:Name="PART_ContentHost"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter TargetName="borderForTextBox" Property="BorderBrush" Value="{StaticResource SelectedBorder}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!---->

    
    <!--Стиль для круглой кнопки -->
    <Style x:Key="BtnCircle" TargetType="{x:Type Button}">
        <Setter Property="Background" Value="{StaticResource OtherBackground}"/>
        <Setter Property="Foreground" Value="{StaticResource MainTextForeground}"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="btnBorder" 
                            CornerRadius="100"
                            Background="{TemplateBinding Background}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            BorderBrush="{TemplateBinding BorderBrush}">
                        <ContentPresenter x:Name="ContentPresenter" 
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!---->


    <!--Стиль для круглой кнопки -->
    <Style x:Key="BtnClearBackground" TargetType="{x:Type Button}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource MainTextForeground}"/>
        <Setter Property="FontFamily" Value="Proletarsk"/>
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="btnBorder" 
                            CornerRadius="5"
                            Background="{TemplateBinding Background}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            BorderBrush="{TemplateBinding BorderBrush}">
                        <ContentPresenter x:Name="ContentPresenter" 
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!---->


    <!--Стиль для ListBox навигации-->
    <Style x:Key="ListBoxNav" TargetType="ListBox">
        <Setter Property="Padding" Value="10"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        
    </Style>
    <!---->

    
    <!--Стиль для ListBoxItem навигации-->
    <Style x:Key="ListBoxItemNav" TargetType="ListBoxItem">
        <Setter Property="Padding" Value="0"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="listBoxBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="15">
                        <ContentPresenter x:Name="ContentPresenter"
                                          VerticalAlignment="Center"
                                          HorizontalAlignment="Left"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
        </Style.Triggers>
    </Style>
    <!---->

    <!--Стиль для Expander навигации Clients-->
    <Style x:Key="expanderNavClients" TargetType="Expander">
        <Setter Property="Foreground" Value="{StaticResource MainTextForeground}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="FontFamily" Value="Proletarsk"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Expander">
                    <Border BorderBrush="{TemplateBinding BorderBrush}" 
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Name="border"
                            Background="{TemplateBinding Background}"
                            FocusVisualStyle="{x:Null}"
                            CornerRadius="15">
                        <StackPanel 
                                    HorizontalAlignment="Left"
                                    Margin="0,0,0,0">

                            <!-- Заголовок Expander -->
                            <DockPanel x:Name="HeaderPanel"
                                       Focusable="False"
                                       Height="50">

                                <Image 
                                    Source="pack://application:,,,/Resources/Images/MainWin/Navigation/IcnClients.png"
                                    RenderOptions.BitmapScalingMode="HighQuality"
                                    Width="25" Height="25"
                                    Margin="7,0,20,0"/>

                                <TextBlock Text="{TemplateBinding Header}"
                                           x:Name="tblock"
                                           Foreground="{StaticResource MainTextForeground}"
                                           FontSize="14"
                                           VerticalAlignment="Center"/>

                                <Image x:Name="ArrowIcon"
                                   Source="pack://application:,,,/Resources/Images/MainWin/Navigation/arrowDown.png"
                                   RenderOptions.BitmapScalingMode="HighQuality"
                                   Width="8" Height="8"
                                   Margin="90,0,16,0"
                                   HorizontalAlignment="Right"
                                   DockPanel.Dock="Right"/>
                            </DockPanel>

                            <!-- Контент Expander -->
                            <ContentPresenter x:Name="ExpandSite" Visibility="Collapsed"/>
                        </StackPanel>
                    </Border>

                    <ControlTemplate.Triggers>
                        <!-- Изменение иконки при разворачивании -->
                        <Trigger Property="IsExpanded" Value="True">
                            <Setter TargetName="ArrowIcon" Property="Source" 
                                Value="pack://application:,,,/Resources/Images/MainWin/Navigation/arrowUp.png"/>
                            <Setter TargetName="ExpandSite" Property="Visibility" Value="Visible"/>
                        </Trigger>

                        <Trigger Property="IsExpanded" Value="False">
                            <Setter TargetName="ArrowIcon" Property="Source" 
                                Value="pack://application:,,,/Resources/Images/MainWin/Navigation/arrowDown.png"/>
                            <Setter TargetName="ExpandSite" Property="Visibility" Value="Collapsed"/>
                        </Trigger>

                        <Trigger Property="IsFocused" Value="True">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderBrush" Value="Transparent"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!---->

    <!--Стиль для Expander навигации Orders-->
    <Style x:Key="expanderNavOrders" TargetType="Expander">
        <Setter Property="Foreground" Value="{StaticResource MainTextForeground}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="FontFamily" Value="Proletarsk"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Expander">
                    <Border BorderBrush="{TemplateBinding BorderBrush}" 
                        BorderThickness="{TemplateBinding BorderThickness}"
                        Name="border"
                        Background="{TemplateBinding Background}"
                        FocusVisualStyle="{x:Null}"
                        CornerRadius="15">
                        <StackPanel 
                                HorizontalAlignment="Left"
                                Margin="0,0,0,0">

                            <!-- Заголовок Expander -->
                            <DockPanel x:Name="HeaderPanel"
                                   Focusable="False"
                                   Height="50">

                                <Image 
                                Source="pack://application:,,,/Resources/Images/MainWin/Navigation/IcnOrder.png"
                                RenderOptions.BitmapScalingMode="HighQuality"
                                Width="24" Height="24"
                                Margin="10,0,20,0"/>

                                <TextBlock Text="{TemplateBinding Header}"
                                       x:Name="tblock"
                                       Foreground="{StaticResource MainTextForeground}"
                                       FontSize="14"
                                       VerticalAlignment="Center"/>

                                <Image x:Name="ArrowIcon"
                               Source="pack://application:,,,/Resources/Images/MainWin/Navigation/arrowDown.png"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               Width="8" Height="8"
                               Margin="90,0,16,0"
                               HorizontalAlignment="Right"
                               DockPanel.Dock="Right"/>
                            </DockPanel>

                            <!-- Контент Expander -->
                            <ContentPresenter x:Name="ExpandSite" Visibility="Collapsed"/>
                        </StackPanel>
                    </Border>

                    <ControlTemplate.Triggers>
                        <!-- Изменение иконки при разворачивании -->
                        <Trigger Property="IsExpanded" Value="True">
                            <Setter TargetName="ArrowIcon" Property="Source" 
                            Value="pack://application:,,,/Resources/Images/MainWin/Navigation/arrowUp.png"/>
                            <Setter TargetName="ExpandSite" Property="Visibility" Value="Visible"/>
                        </Trigger>

                        <Trigger Property="IsExpanded" Value="False">
                            <Setter TargetName="ArrowIcon" Property="Source" 
                            Value="pack://application:,,,/Resources/Images/MainWin/Navigation/arrowDown.png"/>
                            <Setter TargetName="ExpandSite" Property="Visibility" Value="Collapsed"/>
                        </Trigger>

                        <Trigger Property="IsFocused" Value="True">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderBrush" Value="Transparent"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!---->



    <!--Стиль ListBoxItem-->
    <Style TargetType="ListBoxItem">
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Width" Value="224"/>
        <Setter Property="Height" Value="189"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="border"
                        CornerRadius="15"
                        Background="{TemplateBinding Background}"
                        Width="{TemplateBinding Width}"
                        Height="{TemplateBinding Height}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        BorderBrush="{TemplateBinding BorderBrush}">
                        <ContentPresenter
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Width="{TemplateBinding Width}"
                        Height="{TemplateBinding Height}"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!---->

    <!--Стиль RadioButton галочка-->
    <Style TargetType="RadioButton" x:Key="RaddioButtonCheck">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <ContentPresenter
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        Width="{TemplateBinding Width}"
                        Height="{TemplateBinding Height}"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsChecked" Value="False">
                <Setter Property="Visibility" Value="Collapsed"/>
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
                <Setter Property="Visibility" Value="Visible"/>
            </Trigger>
        </Style.Triggers>
    </Style>
    <!---->

    <!--Стиль для вертикального ScrollViewer-->
    <Style x:Key="ScrollBarThumbStyle" TargetType="Thumb">
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Height" Value="200"/>
        <Setter Property="Margin" Value="1,0,1,0" />
        <Setter Property="Background" Value="Honeydew" />
        <Setter Property="BorderBrush" Value="Black" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Rectangle RadiusX="20" RadiusY="20" Height="{TemplateBinding Height}" Fill="Lime"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ScrollBarPageButtonStyle" TargetType="RepeatButton">
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="Transparent" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ScrollBarLineButtonStyle" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Grid Margin="1">
                        <Ellipse Name="Border" StrokeThickness="2" Stroke="Black" Fill="Gray" />
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Border" Property="Fill" Value="Blue" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <ControlTemplate x:Key="scroll" TargetType="ScrollBar">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="5" />
                <RowDefinition Height="*" />
                <RowDefinition Height="5" />
            </Grid.RowDefinitions>

            <Track Grid.Row="1" ViewportSize="100" IsDirectionReversed="True" x:Name="PART_Track">
                <Track.Thumb>
                    <Thumb Style="{StaticResource ScrollBarThumbStyle}" />
                </Track.Thumb>
            </Track>
        </Grid>
    </ControlTemplate>



    <Style TargetType="ScrollViewer" x:Key="VerticalScrollViewer">
        <Setter Property="Background" Value="Red"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollViewer">
                    <Border x:Name="border" CornerRadius="5" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                        <Grid Background="{TemplateBinding Background}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <ScrollContentPresenter x:Name="ScrollContentPresenter"
                                                  Cursor="{TemplateBinding Cursor}"
                                                  Margin="{TemplateBinding Padding}"
                                                  ContentTemplate="{TemplateBinding ContentTemplate}"/>

                            <Rectangle Grid.Column="1" Grid.Row="1" Fill="#FFE9EEF4"/>

                            <ScrollBar Name="PART_VerticalScrollBar" Width="18"
                                     IsTabStop="False"
                                     Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"
                                     Grid.Column="1" Grid.Row="0" Orientation="Vertical"
                                     ViewportSize="{TemplateBinding ViewportHeight}"
                                     Maximum="{TemplateBinding ScrollableHeight}"
                                     Minimum="0"
                                     Value="{TemplateBinding VerticalOffset}"
                                     Margin="0,-1,-1,-1" Template="{StaticResource scroll}"
                                           SnapsToDevicePixels="True" OverridesDefaultStyle="True"/>

                            <ScrollBar Name="PART_HorizontalScrollBar" Height="18"
                                     IsTabStop="False"
                                     Visibility="{TemplateBinding ComputedHorizontalScrollBarVisibility}"
                                     Grid.Column="0" Grid.Row="1" Orientation="Horizontal"
                                     ViewportSize="{TemplateBinding ViewportWidth}"
                                     Maximum="{TemplateBinding ScrollableWidth}"
                                     Minimum="0"
                                     Value="{TemplateBinding HorizontalOffset}"
                                     Margin="-1,0,-1,-1"/>

                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!---->



</ResourceDictionary>