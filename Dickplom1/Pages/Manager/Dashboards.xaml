<Page x:Class="Dickplom1.Pages.Manager.Dashboards"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Dickplom1.Class"
      xmlns:customControls="clr-namespace:CustomControlsForDiplomFramework;assembly=CustomControlsForDiplomFramework"
      xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
      mc:Ignorable="d"
      d:DesignWidth="1195"
      Height="auto"
      MinHeight="820" 
      VerticalAlignment="Stretch"
      RenderOptions.BitmapScalingMode="HighQuality"
      Title="Dashboards"
      MouseDown="Page_MouseDown">
    <Page.DataContext>
        <local:ViewModel/>
    </Page.DataContext>
    

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="30"/>
            <!--Первый уровень (маленькие плитки)-->
            <RowDefinition Height="180"/>
            <RowDefinition Height="30"/>
            <!--Второй уровень (Средние плитки)-->
            <RowDefinition Height="430"/>
            <RowDefinition Height="30"/>
            <!--Третий уровень (Большая плитка)-->
            <RowDefinition Height="380"/>
            <RowDefinition Height="30"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="30"/>
            <ColumnDefinition Width="*" MinWidth="330" MaxWidth="371"/>
            <ColumnDefinition Width="30"/>
            <ColumnDefinition Width="*" MinWidth="330" MaxWidth="371"/>
            <ColumnDefinition Width="30"/>
            <ColumnDefinition Width="*" MinWidth="400" MaxWidth="772"/>
            <ColumnDefinition Width="30"/>
        </Grid.ColumnDefinitions>


        <Grid
            Name="gridSalesAll"
            Grid.Column="1"
            Grid.Row="1"
            HorizontalAlignment="Stretch">

            <Border
                CornerRadius="20"
                Background="{StaticResource PlitkaBackground}"
                HorizontalAlignment="Stretch"/>

            <Label
                Style="{StaticResource TextZagolovokDashboard}"
                Content="Продано всего"
                Margin="20,20"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Padding="0"/>

            <TextBlock
                Style="{StaticResource TextZagolovokValueDashboard}"
                Text="0" MaxWidth="200"
                Margin="20,75,0,0"
                FontSize="75"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"/>

            <Grid 
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Height="auto"
                Width="90"
                Cursor="Hand"
                Margin="0,20,20,0"
                MouseLeftButtonUp="Grid_MouseLeftButtonUp">
                
                <StackPanel 
                    Orientation="Horizontal"
                    Height="20"
                    VerticalAlignment="Top"
                    HorizontalAlignment="Right">
                    
                    <TextBlock
                        Name="tbSalesAllChosenDate"
                        Style="{StaticResource TextComboboxDashboard}"
                        Text="за год"/>
                    
                    <Rectangle 
                        Opacity="0"      
                        Fill="Transparent" 
                        Width="25"
                        VerticalAlignment="Stretch"/>

                    <Image Source="/Resources/Images/MainWin/arrowDownGray.png"
                        RenderOptions.BitmapScalingMode="HighQuality"
                        VerticalAlignment="Center"
                        Name="ImgReportsArrowDown"
                        Width="8"
                        Margin="-10,0,0,0"/>
                </StackPanel>


                <Grid 
                    Name="gridSalesAllChoseDate"  
                    Height="auto"
                      Margin="0,20,0,0" 
                      Width="80"
                      HorizontalAlignment="Right"
                      VerticalAlignment="Top"
                      Visibility="Collapsed">
                    
                    <Border Background="White"
                            BorderBrush="{StaticResource SelectedBorder}"
                            BorderThickness="0.8"
                            CornerRadius="10"/>
                    <StackPanel 
                        Orientation="Vertical">
                        
                        <Separator Opacity="0" Height="2"/>

                        <StackPanel Orientation="Horizontal">
                            <TextBlock
                                Name="tbYear"
                                Text="Год"
                                Foreground="Gray"
                                Width="75"
                                Padding="5,0"
                                Style="{StaticResource DefText13}"
                                MouseLeftButtonUp="TextBlock_MouseLeftButtonUp_2"
                                MouseEnter="TextBlock_MouseEnter"
                                MouseLeave="TextBlock_MouseLeave"/>

                            <RadioButton 
                                x:Name="rbtnChoseDateSalesAllYear"
                                GroupName="rbtnsDashboardSalesAll"
                                Style="{StaticResource RaddioButtonCheck}" 
                                Width="8" Height="16" 
                                IsChecked="True"
                                HorizontalAlignment="Right" VerticalAlignment="Center"
                                Margin="-10,0,0,0">
                                <RadioButton.Content>
                                    <Image 
                                        Source="/Resources/Images/MainWin/MiniProfile/ImgCheck.png"
                                        RenderOptions.BitmapScalingMode="HighQuality"/>
                                </RadioButton.Content>
                            </RadioButton>
                        </StackPanel>

                        <Separator Opacity="0" Height="2"/>

                        <StackPanel Orientation="Horizontal">
                            <TextBlock
                                x:Name="tbMounth"
                                Text="Месяц"
                                Foreground="Gray"
                                Width="75"
                                Padding="5,0"
                                Style="{StaticResource DefText13}"
                                MouseLeftButtonUp="TextBlock_MouseLeftButtonUp"
                                MouseEnter="TextBlock_MouseEnter_1"
                                MouseLeave="TextBlock_MouseLeave_1"/>
                            
                            <RadioButton 
                                x:Name="rbtnChoseDateSalesAllMounth"
                                GroupName="rbtnsDashboardSalesAll"
                                Style="{StaticResource RaddioButtonCheck}" 
                                Width="8" Height="16" 
                                IsChecked="False"
                                HorizontalAlignment="Right" VerticalAlignment="Center"
                                Margin="-10,0,0,0">
                                <RadioButton.Content>
                                    <Image 
                                        Source="/Resources/Images/MainWin/MiniProfile/ImgCheck.png"
                                        RenderOptions.BitmapScalingMode="HighQuality"/>
                                </RadioButton.Content>
                                
                            </RadioButton>
                        </StackPanel>

                        <Separator Opacity="0" Height="2"/>

                        <StackPanel Orientation="Horizontal">
                            <TextBlock
                                Name="tbWeek"
                                Text="Неделя"
                                Foreground="Gray"
                                Width="75"
                                Padding="5,0"
                                Style="{StaticResource DefText13}"
                                MouseLeftButtonUp="TextBlock_MouseLeftButtonUp_1"
                                MouseEnter="tbWeek_MouseEnter"
                                MouseLeave="tbWeek_MouseLeave"/>

                            <RadioButton 
                                x:Name="rbtnChoseDateSalesAllWeek"
                                GroupName="rbtnsDashboardSalesAll"
                                Style="{StaticResource RaddioButtonCheck}" 
                                Width="8" Height="16" 
                                IsChecked="False"
                                HorizontalAlignment="Right" VerticalAlignment="Center"
                                Margin="-10,0,0,0">
                                <RadioButton.Content>
                                    <Image 
                                        Source="/Resources/Images/MainWin/MiniProfile/ImgCheck.png"
                                        RenderOptions.BitmapScalingMode="HighQuality"/>
                                </RadioButton.Content>
                            </RadioButton>
                        </StackPanel>
                        
                        <Separator Opacity="0" Height="2"/>

                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>

        <Grid
            Name="gridLeaderOfSales"
            Grid.Column="3"
            Grid.Row="1"
            HorizontalAlignment="Stretch">

            <Border
                CornerRadius="20"
                Background="{StaticResource PlitkaBackground}"
                HorizontalAlignment="Stretch"/>
            
            <Label
                Style="{StaticResource TextZagolovokDashboard}"
                Content="Лидеры продаж"
                Margin="20,20"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Padding="0"/>

            <StackPanel 
                Orientation="Vertical"
                Margin="20,77,0,0"
                HorizontalAlignment="Left" VerticalAlignment="Top">
                <TextBlock
                    Style="{StaticResource TextZagolovokValueDashboard}"
                    Text="Пример товара" MaxWidth="200"
                    FontSize="20"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"/>
                
                <Separator Opacity="0" Height="10"/>

                <TextBlock
                    Style="{StaticResource TextZagolovokValueDashboard}"
                    Text="Доп. информация" MaxWidth="200"
                    FontSize="13"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"/>
            </StackPanel>

            <customControls:CustomComboboxForChoseDateGray 
                HorizontalAlignment="Right" VerticalAlignment="Top"
                Panel.ZIndex="1"/>
            
            <Image
                Source="/Resources/Images/Dashboards/productPrimer.png"
                Height="95" Width="80"
                Panel.ZIndex="0"
                Stretch="Fill"
                IsHitTestVisible="False"
                IsEnabled="False"
                VerticalAlignment="Top" HorizontalAlignment="Right"
                Margin="0,50,20,0"
                RenderOptions.BitmapScalingMode="HighQuality"/>


        </Grid>

        <Grid
            Name="gridRatioOrders"
            Grid.Column="5"
            Grid.Row="1"
            HorizontalAlignment="Stretch">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border
                Grid.ColumnSpan="4"
                CornerRadius="20"
                Background="{StaticResource PlitkaBackground}"
                HorizontalAlignment="Stretch"/>

            <Label
                Style="{StaticResource TextZagolovokDashboard}"
                Content="Процент успешных сделок"
                Margin="20,20"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Padding="0"/>

            <customControls:CustomComboboxForChoseDateGray 
                HorizontalAlignment="Right" VerticalAlignment="Top"
                Grid.Column="1"
                Grid.ColumnSpan="3"
                Panel.ZIndex="1"/>

            <StackPanel 
                Orientation="Vertical"
                Width=" 190" Height="75"
                HorizontalAlignment="Left" VerticalAlignment="Top"
                Margin="20,73,0,0">

                <Grid
                    HorizontalAlignment="Stretch"
                    Height="33">

                    <Border
                        Background="White"
                        CornerRadius="5"/>

                    <StackPanel Orientation="Horizontal">

                        <Separator Opacity="0" Width="10"/>

                        <Image 
                            Source="/Resources/Images/Dashboards/DotGray.png"
                            Width="10"
                            RenderOptions.BitmapScalingMode="HighQuality"/>

                        <Separator Opacity="0" Width="10"/>

                        <TextBlock
                            Style="{StaticResource DefText13}"
                            Text="0 завершенных сделок" MaxWidth="200"
                            VerticalAlignment="Center"/>

                    </StackPanel>

                </Grid>

                <Separator Opacity="0" Height="5"/>

                <Grid
                    HorizontalAlignment="Stretch"
                    Height="33">

                    <Border
                        Background="White"
                        CornerRadius="5"/>

                    <StackPanel Orientation="Horizontal">
                        <Separator Opacity="0" Width="10"/>

                        <Image 
                            Source="/Resources/Images/Dashboards/DotWhite.png"
                            Width="10"
                            RenderOptions.BitmapScalingMode="HighQuality"/>

                        <Separator Opacity="0" Width="10"/>

                        <TextBlock
                            Style="{StaticResource DefText13}"
                            Text="0 отмененных сделок" MaxWidth="200"
                            VerticalAlignment="Center"/>
                    </StackPanel>

                </Grid>

            </StackPanel>
            <!--Попробуй засунуть ее в грид и поставить максимальную длинну -->
            <lvc:PieChart
                Grid.Column="1"
                FontFamily="Proletarsk"
                Height="130" Width="130"
                Series="{Binding Series}"
                InitialRotation="-90"
                MinValue="0"
                MaxValue="100"
                Padding="0"    
                Background="Red"
                LegendPosition="Hidden"
                HorizontalAlignment="Center"
                Margin="{Binding ElementName=MainGrid, Path=ActualWidth}">
            </lvc:PieChart>

        </Grid>

        <Grid
            Name="gridOrdersStatuses"
            Grid.Column="1" Grid.ColumnSpan="3"
            Grid.Row="3"
            HorizontalAlignment="Stretch">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="50"/>
            </Grid.ColumnDefinitions>

            <Border
                Grid.Column="0" Grid.ColumnSpan="3"
                CornerRadius="20"
                Background="{StaticResource PlitkaBackground}"
                HorizontalAlignment="Stretch"/>

            <Grid 
                x:Name="gridStatusSalesSorting"
                HorizontalAlignment="Right"  
                VerticalAlignment="Top"
                Height="auto"
                Width="auto"
                Cursor="Hand"
                Grid.Column="1"
                Margin="0,66,0,0"
                MouseLeftButtonUp="gridStatusSalesSorting_MouseLeftButtonUp">
                <StackPanel 
                    Orientation="Horizontal"
                    Height="20"
                    VerticalAlignment="Top"
                    HorizontalAlignment="Right">
                    <TextBlock
                        Style="{StaticResource TextComboboxDashboard}"
                        HorizontalAlignment="Stretch"
                        Text="Сортировать"/>

                    <Rectangle 
                        Opacity="0"      
                        Fill="Transparent" 
                        Width="25"
                        VerticalAlignment="Stretch"/>

                    <Image 
                        Source="/Resources/Images/MainWin/arrowDownGray.png"
                        RenderOptions.BitmapScalingMode="HighQuality"
                        VerticalAlignment="Center"
                        Name="ImgStatusDashboardSorting"
                        Width="8"
                        Margin="-10,0,0,0"/>
                </StackPanel>
            </Grid>

            <Label
                Grid.Column="1"
                Style="{StaticResource TextZagolovokDashboard}"
                Content="Статусы заказов"
                Margin="0,20"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Padding="0"/>

            <StackPanel 
                Grid.Column="1"
                Orientation="Horizontal"
                Height="15"
                HorizontalAlignment="Right" VerticalAlignment="Top"
                Margin="0,22,0,0">

                <TextBlock
                    Style="{StaticResource DefText13}"     
                    Text="0/0 сделок завершено"    
                    VerticalAlignment="Center"/>

                <Separator Opacity="0" Width="25"/>

                <!--Чтобы передать значение для прогрессбара нужно как-то обратиться к его Value и задать его значение. Минимум 10-->
                <customControls:ProgressBarGray
                    Width="100" 
                    VerticalAlignment="Center"
                    Margin="0,1,0,0"/>
            </StackPanel>



            <Grid 
                Grid.Column="1" Grid.ColumnSpan="2"
                Background="Transparent"
                HorizontalAlignment="Stretch"
                Margin="0,0,10,15"
                VerticalAlignment="Bottom">
                <Border
                    Grid.Column="1" Grid.ColumnSpan="2"
                    CornerRadius="8"
                    Background="#FFDADADB"
                    HorizontalAlignment="Stretch"
                    Margin="0,0,35,0"
                    VerticalAlignment="Stretch"/>

                <ScrollViewer
                    x:Name="MainContentScroll"
                    Tag="MainContentScroll"
                    Height="310"
                    HorizontalAlignment="Stretch"
                    Grid.Column="1" Grid.ColumnSpan="2"
                    VerticalAlignment="Bottom"
                    Style="{StaticResource VerticalScrollViewer}"
                    CanContentScroll="True">
                    <Grid>
                        <Border
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Top"
                            CornerRadius="8"
                            Background="White"
                            Height="30"/>
                        <customControls:DataGridMaterialDesignCustom
                            x:Name="DataGridCustom"
                            PreviewMouseWheel="DataGridCustom_PreviewMouseWheel"
                            VerticalAlignment="Top"
                            HorizontalAlignment="Stretch"/>
                    </Grid>
                </ScrollViewer>
            </Grid>
        </Grid>

        <Grid
            Name="gridDinamicOrders"
            Grid.Column="5"
            Grid.Row="3"
            HorizontalAlignment="Stretch">

            <Border
                CornerRadius="20"
                Background="{StaticResource PlitkaBackground}"
                HorizontalAlignment="Stretch"/>
            
            <Label
                Style="{StaticResource TextZagolovokDashboard}"
                Content="Динамика продаж"
                Margin="20,20"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Padding="0"/>

            <Grid>
                <Border
                    CornerRadius="20"
                    Background="White"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Height="355" Width="360"
                    Margin="20,60,0,0"/>
                
                
            </Grid>
        </Grid>

        <Grid
            Name="gridDashboardStaff"
            Grid.Column="1" Grid.ColumnSpan="5"
            Grid.Row="5"
            HorizontalAlignment="Stretch">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="530"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="20"/>
            </Grid.ColumnDefinitions>

            <Border
                CornerRadius="20"
                Grid.ColumnSpan="3"
                Background="{StaticResource PlitkaBackground}"
                HorizontalAlignment="Stretch"/>
            
            <Label
                Style="{StaticResource TextZagolovokDashboard}"
                Content="Аналитика сотрудников"
                Margin="20,20"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Padding="0"/>

            <Border
                CornerRadius="20"
                Background="White"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Grid.Column="0"
                Height="271" Width="272"
                Margin="20,80,0,0">
                <Grid>
                    <TextBlock
                        Style="{DynamicResource DefText13}"
                        Text="Лидер по KPI"
                        Margin="20,20"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Padding="0"/>
                </Grid>
            </Border>

            <Border
                CornerRadius="20"
                Background="White"
                Grid.Column="0"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Height="300" Width="178"
                Margin="322,49,0,0">
                <Grid>
                    <TextBlock
                        Style="{StaticResource DefText13}"
                        Text="Конверсия клиентов"
                        Margin="0,15"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Top"
                        Padding="0"/>
                    <TextBlock
                        Style="{StaticResource DefText13}"
                        Text="0%"
                        Margin="0,35"
                        FontSize="37.5"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Top"
                        Padding="0"/>

                    <TextBlock
                        Style="{StaticResource DefText13}"
                        Text="Неуспешные сделки"
                        Margin="0,110"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Top"
                        Padding="0"/>
                    <TextBlock
                        Style="{StaticResource DefText13}"
                        Text="0%"
                        Margin="0,130"
                        FontSize="37.5"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Top"
                        Padding="0"/>

                    <TextBlock
                        Style="{StaticResource DefText13}"
                        Text="Среднее время сделок"
                        Margin="0,70"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Bottom"
                        Padding="0"/>
                    <TextBlock
                        Style="{StaticResource DefText13}"
                        Text="0 ч"
                        Margin="0,20"
                        FontSize="37.5"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Bottom"
                        Padding="0"/>
                </Grid>
            </Border>

            <Border    
                CornerRadius="20"
                Background="White"
                Grid.Column="1"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Top"
                Height="301"
                Margin="0,49,0,0">
                <Grid>
                    <Label
                        Style="{StaticResource TextZagolovokDashboard}"
                        Content="Таблица сотрудников"
                        Margin="20,20"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Padding="0"/>
                    <TextBlock
                        Style="{StaticResource DefText13}"
                        Text="Средний KPI 0%"
                        Foreground="Gray"
                        Margin="55,40"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Padding="0"/>
                    <ScrollViewer
                        x:Name="StaffContentScroll"
                        Height="210"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Bottom"
                        Style="{StaticResource VerticalScrollViewer}"
                        Margin="20,20,20,20"
                        CanContentScroll="True">
                        <customControls:DataGridMaterialDesignCustomForStaff    
                            x:Name="dgStaff"
                            PreviewMouseWheel="dgStaff_PreviewMouseWheel"/>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
