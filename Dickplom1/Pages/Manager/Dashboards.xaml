<Page x:Class="Dickplom1.Pages.Manager.Dashboards"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Dickplom1.Pages.Manager"
      mc:Ignorable="d"
      d:DesignWidth="1180"
      Height="820"
      MaxHeight="1120"
      MinHeight="820" 
      RenderOptions.BitmapScalingMode="HighQuality"
      Title="Dashboards">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="30"/>
            <!--Первый уровень (маленькие плитки)-->
            <RowDefinition Height="180"/>
            <RowDefinition Height="30"/>
            <!--Второй уровень (Средние плитки)-->
            <RowDefinition Height="430"/>
            <RowDefinition Height="30"/>
            <!--Третий уровень (Большая плитка)-->
            <RowDefinition Height="380"/>
            <RowDefinition Height="30"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="30"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="30"/>
        </Grid.ColumnDefinitions>
        
        <Border CornerRadius="20"
                Grid.ColumnSpan="3"
                VerticalAlignment="Top"
                Height="820"
                MaxHeight="1120"
                Grid.RowSpan="7">
            <Border.Background>
                <LinearGradientBrush EndPoint="0,1" StartPoint="0,0">
                    <LinearGradientBrush.RelativeTransform>
                        <TransformGroup>
                            <ScaleTransform CenterY="0.5" CenterX="0.5"/>
                            <SkewTransform CenterX="0.5" CenterY="0.5"/>
                            <RotateTransform Angle="90" CenterX="0.5" CenterY="0.5"/>
                            <TranslateTransform/>
                        </TransformGroup>
                    </LinearGradientBrush.RelativeTransform>
                    <GradientStop Color="#F6F6F8" Offset="1"/>
                    <GradientStop Color="#F6F6F8" Offset="0"/>
                    <GradientStop Color="#FFFEFEFE" Offset="0.5"/>
                </LinearGradientBrush>
            </Border.Background>
        </Border>

        

        <Grid
            x:Name="SPFirstLevelTopics"
            Grid.Row="1"
            Grid.Column="1">

            <Grid
                Name="gridSalesAll"
                Width="330" Height="180"
                HorizontalAlignment="Left"
                VerticalAlignment="Center">

                <Border 
                    CornerRadius="20"
                    Background="{StaticResource PlitkaBackground}"/>
            </Grid>
            
            <Grid
                Name="gridSalesLeader"
                Width="330" Height="180"
                HorizontalAlignment="Center"
                Margin="0,0,70,0"
                VerticalAlignment="Center">

                <Border 
                    CornerRadius="20"
                    Background="{StaticResource PlitkaBackground}"/>
            </Grid>
            
            <Grid
                Name="gridSuccessfulSales"
                Width="400" Height="180"
                HorizontalAlignment="Right"
                VerticalAlignment="Center">

                <Border 
                    CornerRadius="20"
                    Background="{StaticResource PlitkaBackground}"/>
            </Grid>
        </Grid>

        <Grid
            x:Name="SPSecondLevelTopics"
            HorizontalAlignment="Stretch"
            Grid.Row="3"
            Grid.Column="1">

            <Grid
                Name="gridOrdersStatus"
                Width="690" Height="430"
                HorizontalAlignment="Left"
                VerticalAlignment="Center">

                <Border 
                    CornerRadius="20"
                    Background="{StaticResource PlitkaBackground}"/>
            </Grid>


            <Grid
                Name="gridOrdersDynamic"
                Width="400" Height="430"
                HorizontalAlignment="Right"
                VerticalAlignment="Center">

                <Border 
                    CornerRadius="20"
                    Background="{StaticResource PlitkaBackground}"/>
            </Grid>
        </Grid>

        <Grid
            Name="gridThirdLevelTopic"
            Width="auto" Height="380"
            VerticalAlignment="Center"
            Grid.Row="5"
            Grid.Column="1">

            <Border 
                    CornerRadius="20"
                    Background="{StaticResource PlitkaBackground}"/>
        </Grid>


    </Grid>
</Page>
