<Page x:Class="Dickplom1.Pages.Manager.ClientsNaturalPersons"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:customControls="clr-namespace:CustomControlsForDiplomFramework;assembly=CustomControlsForDiplomFramework"
      xmlns:local="clr-namespace:Dickplom1.Class"
      mc:Ignorable="d"
      d:DesignWidth="1195"
      Height="auto"
      MinHeight="820" 
      VerticalAlignment="Stretch"
      RenderOptions.BitmapScalingMode="HighQuality">

    <Grid>
        <TextBlock
            Text="Клиенты (Физические лица)"
            Style="{DynamicResource DefText15}"
            FontSize="25"
            VerticalAlignment="Top"
            HorizontalAlignment="Left"
            Margin="40,40,0,0"/>

        <Grid
            VerticalAlignment="Top"
            HorizontalAlignment="Stretch"
            Margin="40,110">
            <Border
                HorizontalAlignment="Stretch"
                VerticalAlignment="Top"
                CornerRadius="8"
                Background="White"
                Height="30"/>
            <customControls:DataGridMaterialDesignCustomForClients
                x:Name="DataGridCustomForClients"
                VerticalAlignment="Top"
                HorizontalAlignment="Stretch"/>
        </Grid>
        
        <customControls:CustomComboboxFilterForClients
            x:Name="ComboboxesFilter"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            Margin="0,50,235,0"/>

        <customControls:BlueButtomMaterialDesignCustom
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            Margin="0,40,40,0"/>
    </Grid>
</Page>
