<Page x:Class="Dickplom1.Pages.Manager.OrdersNaturalPersons"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:customControls="clr-namespace:CustomControlsForDiplomFramework;assembly=CustomControlsForDiplomFramework"
      xmlns:wpf="clr-namespace:MaterialDesignThemes.Wpf;assembly=MaterialDesignThemes.Wpf"
      xmlns:local="clr-namespace:Dickplom1.Class"
      mc:Ignorable="d"
      d:DesignWidth="1195"
      Height="auto"
      MinHeight="820" 
      VerticalAlignment="Stretch"
      RenderOptions.BitmapScalingMode="HighQuality"
      Background="Transparent">
    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesign2.Defaults.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Page.Resources>

    <Grid>
        <Grid 
            x:Name="gridFocus"
            VerticalAlignment="Top"/>
        <TextBlock
            Text="Заказы (Физические лица)"
            Style="{DynamicResource DefText15}"
            FontSize="25"
            VerticalAlignment="Top"
            HorizontalAlignment="Left"
            Margin="40,40,0,0"/>

        <StackPanel 
            Orientation="Vertical"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Bottom"
            Margin="40,110,40,30">

            <Grid
                VerticalAlignment="Top"
                HorizontalAlignment="Stretch">
                <Border
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Top"
                    CornerRadius="8"
                    Background="White"
                    Height="30"/>
                <customControls:DataGridMaterialDesignCustomForOrdersNaturalPersons
                    x:Name="DataGridCustomForOrdersNaturalPersons"
                    Height="625"
                    VerticalAlignment="Top"
                    HorizontalAlignment="Stretch"
                    Loaded="DataGridCustomForOrdersNaturalPersons_Loaded"/>
            </Grid>
            <Grid
                VerticalAlignment="Bottom"
                HorizontalAlignment="Stretch">

                <Border
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Bottom"
                    CornerRadius="8"
                    Background="White"
                    Height="50"/>
                <StackPanel 
                    x:Name="spPaggination"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Height="20"
                    Margin="0,10,0,0">
                </StackPanel>
                <Rectangle 
                VerticalAlignment="Top"
                Fill="{StaticResource OtherBackground}" 
                Height="10"
                Margin="0,0,0,0"/>
            </Grid>
        </StackPanel>

        <TextBlock 
            x:Name="tbInfo"
            Style="{StaticResource DefText15}"
            Text="Данные не найдены"
            TextAlignment="Center"
            Visibility="Collapsed"/>

        <customControls:CustomComboboxFilterForClients
            x:Name="ComboboxesFilter"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            Margin="0,50,235,0"/>

        <customControls:ButtomWithBorder
            x:Name="btnAddOrder"
            Content="Добавить заказ"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            Margin="0,40,40,0"
            Loaded="ButtomWithBorder_Loaded"/>
    </Grid>
</Page>
